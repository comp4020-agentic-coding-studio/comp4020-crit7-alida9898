---
// Every page's shell: the invariants in spec/ want a language, a viewport,
// a real title, a nav landmark and exactly one h1 (the page supplies the h1).
// Plan pages pass `plan` to get the left-hand plan sidebar.
import "../styles.css";
import PlanSidebar, { type PlanPage } from "./PlanSidebar.astro";

interface Props {
  title: string;
  plan?: { id: string; current: PlanPage; course?: string; savedId?: number };
}

const { title, plan } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&display=swap"
    />
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/"><span class="mark" aria-hidden="true"></span>Schedule Builder</a>
      <span class="term">Semester 2 · 2026</span>
      <nav aria-label="site">
        <a href="/example/">Example</a>
        <a href="/readme/">About</a>
      </nav>
    </header>
    {
      plan ? (
        <div class="shell">
          <PlanSidebar planId={plan.id} current={plan.current} course={plan.course} savedId={plan.savedId} />
          <main>
            <slot />
          </main>
        </div>
      ) : (
        <main>
          <slot />
        </main>
      )
    }
    <footer>
      <p>
        Class data: the <a href="https://github.com/anucssa/anutimetable">ANU CSSA timetable</a>{" "}
        scrape of the official ANU timetable, Semester 2 2026. Unofficial — check MyTimetable
        before you enrol.
      </p>
    </footer>
  </body>
</html>

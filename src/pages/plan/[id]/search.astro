---
import Layout from "../../../components/Layout.astro";
import { allCourses, allSubjects } from "../../../lib/catalogue";
import { filterCourses, levelOf, levelsIn, matchSubjects, subjectOf } from "../../../lib/course-search";
import { getPlan, listSaved, planCourseIds } from "../../../lib/plans";

const plan = getPlan(Astro.params.id ?? "");
if (!plan) return Astro.rewrite("/404");

const courses = allCourses();
const subjects = allSubjects(courses);
const params = Astro.url.searchParams;
const q = params.get("q")?.trim() ?? "";
const subjectParam = params.get("subject")?.toUpperCase() ?? "";
const subject = subjects.find((s) => s.code === subjectParam);
const levelParam = Number(params.get("level"));

// levels to offer: those present in the subject or query results before the level filter
const unlevelled = filterCourses(courses, subjects, { q, subject: subject?.code });
const levels = levelsIn(unlevelled);
const level = levels.includes(levelParam) ? levelParam : undefined;
const results = level ? unlevelled.filter((c) => levelOf(c.code) === level) : unlevelled;
const namedSubjects = subject ? [] : matchSubjects(subjects, q);
const browsing = !subject && q.length < 2;

const added = new Set(planCourseIds(plan.id));
const savedCount = listSaved(plan.id).length;
const base = `/plan/${plan.id}/search`;
const here = `${Astro.url.pathname}${Astro.url.search}`;

const link = (next: { q?: string; subject?: string; level?: number }) => {
  const out = new URLSearchParams();
  if (next.q) out.set("q", next.q);
  if (next.subject) out.set("subject", next.subject);
  if (next.level) out.set("level", String(next.level));
  const query = out.toString();
  return query ? `${base}?${query}` : base;
};
const heading = subject
  ? `${subject.code} — ${subject.name}`
  : q.length >= 2
    ? `Results for “${q}”`
    : "Browse by subject";
const letters = [...new Set(subjects.map((s) => s.code[0]))];
---

<Layout
  title="Search courses — ANU Schedule Builder"
  plan={{ id: plan.id, savedCount, tab: "search" }}
>
  <div class="page-head">
    <h1>Search courses</h1>
    <p class="hint">
      Semester 2 2026 · {courses.length} courses in {subjects.length} subjects. Pick a subject, or type a code,
      title or subject name.
    </p>
  </div>

  <section class="card" aria-label="Search">
    <div class="card-body">
      <form method="get" role="search" class="finder">
        <div class="field grow">
          <label for="q">Code, title or subject</label>
          <input id="q" name="q" value={q} placeholder="COMP, COMP2100, computing…" />
        </div>
        <div class="field">
          <label for="subject">Subject</label>
          <select id="subject" name="subject" onchange="this.form.requestSubmit()">
            <option value="">All subjects</option>
            {
              subjects.map((s) => (
                <option value={s.code} selected={s.code === subject?.code}>
                  {s.code} — {s.name}
                </option>
              ))
            }
          </select>
        </div>
        {level && <input type="hidden" name="level" value={String(level)} />}
        <button class="primary">Search</button>
      </form>
    </div>
  </section>

  {
    browsing ? (
      <section class="card results-card" aria-labelledby="results-heading">
        <div class="sched-head">
          <h2 id="results-heading">{heading}</h2>
          <nav aria-label="Jump to letter" class="letters">
            {letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
          </nav>
        </div>
        <div class="card-body">
          {letters.map((l) => (
            <div class="letter-group">
              <h3 id={`letter-${l}`}>{l}</h3>
              <ul class="subjects">
                {subjects
                  .filter((s) => s.code[0] === l)
                  .map((s) => (
                    <li>
                      <a href={link({ subject: s.code })}>
                        <strong>{s.code}</strong> <span>{s.name}</span>
                      </a>
                      <small>{s.count}</small>
                    </li>
                  ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ) : (
      <section class="card results-card" aria-labelledby="results-heading">
        <div class="sched-head">
          <div>
            <h2 id="results-heading">{heading}</h2>
            <p class="hint">
              {results.length} {results.length === 1 ? "course" : "courses"}
              {subject?.school && ` · ${subject.school}`}
            </p>
          </div>
          <a class="btn" href={base}>All subjects</a>
        </div>
        <div class="card-body">
          {levels.length > 1 && (
            <nav aria-label="Level" class="chips">
              <a href={link({ q, subject: subject?.code })} aria-current={!level ? "true" : undefined}>
                All levels
              </a>
              {levels.map((l) => (
                <a href={link({ q, subject: subject?.code, level: l })} aria-current={l === level ? "true" : undefined}>
                  {l}-level
                </a>
              ))}
            </nav>
          )}
          {namedSubjects.length > 0 && (
            <p class="hint">
              Subjects matching “{q}”:{" "}
              {namedSubjects.map((s, i) => (
                <>
                  {i > 0 && ", "}
                  <a href={link({ subject: s.code })}>
                    {s.code} {s.name}
                  </a>
                </>
              ))}
            </p>
          )}
          {results.length === 0 ? (
            <p class="empty">No Semester 2 courses match. Try a subject from the list, or fewer letters.</p>
          ) : (
            <ul class="results course-results">
              {results.map((c) => (
                <li>
                  <span class="name">
                    <strong>{c.code}</strong>
                    <small>
                      {c.title}
                      {!subject && ` · ${subjectOf(c.code)}`}
                    </small>
                  </span>
                  {added.has(c.id) ? (
                    <span class="added">✓ Added</span>
                  ) : (
                    <form method="post" action={`/api/plans/${plan.id}/courses`}>
                      <input type="hidden" name="courseId" value={c.id} />
                      <input type="hidden" name="action" value="add" />
                      <input type="hidden" name="back" value={here} />
                      <button class="small" aria-label={`Add ${c.code}`}>Add</button>
                    </form>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )
  }

  <p class="hint">
    {added.size} {added.size === 1 ? "course" : "courses"} in your plan ·{" "}
    <a href={`/plan/${plan.id}`}>See your schedules →</a>
  </p>
</Layout>

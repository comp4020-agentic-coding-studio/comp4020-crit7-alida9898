---
import CourseCard from "../../../components/CourseCard.astro";
import Layout from "../../../components/Layout.astro";
import { allCourses, allSubjects, courseInfo, meetingsFor } from "../../../lib/catalogue";
import { filterCourses, levelOf, levelsIn, matchSubjects, parseSubject } from "../../../lib/course-search";
import { groupOptions } from "../../../lib/generate";
import { getPlan, listPrefs, planCourseIds } from "../../../lib/plans";

const plan = getPlan(Astro.params.id ?? "");
if (!plan) return Astro.rewrite("/404");

const courses = allCourses();
const subjects = allSubjects(courses);
const params = Astro.url.searchParams;
const q = params.get("q")?.trim() ?? "";
const subjectCode = parseSubject(params.get("subject") ?? "", subjects);
const subject = subjects.find((s) => s.code === subjectCode);
const focus = courses.find((c) => c.id === params.get("course"));
const levelParam = Number(params.get("level"));

// levels to offer: those present before the level filter is applied
const unlevelled = focus ? [focus] : filterCourses(courses, subjects, { q, subject: subject?.code });
const levels = focus ? [] : levelsIn(unlevelled);
const level = levels.includes(levelParam) ? levelParam : undefined;
const results = level ? unlevelled.filter((c) => levelOf(c.code) === level) : unlevelled;
const namedSubjects = subject || focus ? [] : matchSubjects(subjects, q);
const browsing = !subject && !focus && q.length < 2;

const planIds = planCourseIds(plan.id);
const inPlan = new Set(planIds);
const prefs = listPrefs(plan.id);
const activitiesOf = new Map<string, ReturnType<typeof groupOptions>>();
for (const options of groupOptions(meetingsFor(results.map((c) => c.id)))) {
  const id = options[0].courseId;
  activitiesOf.set(id, [...(activitiesOf.get(id) ?? []), options]);
}

const base = `/plan/${plan.id}/search`;
const here = `${Astro.url.pathname}${Astro.url.search}`;
const link = (next: { q?: string; subject?: string; level?: number }) => {
  const out = new URLSearchParams();
  if (next.q) out.set("q", next.q);
  if (next.subject) out.set("subject", next.subject);
  if (next.level) out.set("level", String(next.level));
  const query = out.toString();
  return query ? `${base}?${query}` : base;
};
const heading = focus
  ? `${focus.code} ${focus.title}`
  : subject
    ? `${subject.code} — ${subject.name}`
    : q.length >= 2
      ? `Results for “${q}”`
      : "Browse by subject";
const letters = [...new Set(subjects.map((s) => s.code[0]))];
// classes are open when there are few results, or for courses already in the plan
const openClasses = (id: string) => results.length <= 3 || inPlan.has(id);
---

<Layout
  title="Search courses — ANU Schedule Builder"
  plan={{ id: plan.id, current: "search", course: focus?.id }}
>
  <div class="page-head">
    <h1>Search courses</h1>
    <p class="hint">
      Semester 2 2026 · {courses.length} courses in {subjects.length} subjects. Type a code, title or subject,
      or pick a subject.
    </p>
  </div>

  <section class="card" aria-label="Search">
    <div class="card-body">
      <form method="get" role="search" class="finder">
        <div class="field grow">
          <label for="q">Code, title or subject</label>
          <input id="q" name="q" value={q} placeholder="COMP, COMP2100, computing…" autocomplete="off" />
        </div>
        <div class="field">
          <label for="subject">Subject</label>
          <input
            id="subject"
            name="subject"
            list="subject-list"
            value={subject ? `${subject.code} — ${subject.name}` : ""}
            placeholder="Type to filter: comp, law…"
            autocomplete="off"
            onchange="this.form.requestSubmit()"
          />
          <datalist id="subject-list">
            {subjects.map((s) => <option value={`${s.code} — ${s.name}`} />)}
          </datalist>
        </div>
        {level && <input type="hidden" name="level" value={String(level)} />}
        <button class="primary">Search</button>
      </form>
    </div>
  </section>

  <script is:inline>
    const input = document.getElementById("subject");
    const datalist = document.getElementById("subject-list");
    const field = input?.closest(".field");
    if (input instanceof HTMLInputElement && datalist instanceof HTMLDataListElement && field) {
      const values = [...datalist.options].map((o) => o.value);

      const listbox = document.createElement("ul");
      listbox.id = "subject-listbox";
      listbox.className = "combobox-list";
      listbox.setAttribute("role", "listbox");
      listbox.hidden = true;
      const items = values.map((value, i) => {
        const li = document.createElement("li");
        li.id = `subject-option-${i}`;
        li.setAttribute("role", "option");
        li.dataset.value = value;
        li.textContent = value;
        listbox.append(li);
        return li;
      });
      input.after(listbox);

      input.removeAttribute("list");
      input.setAttribute("role", "combobox");
      input.setAttribute("aria-autocomplete", "list");
      input.setAttribute("aria-expanded", "false");
      input.setAttribute("aria-controls", listbox.id);

      let active = -1;
      const visible = () => items.filter((li) => !li.hidden);

      const close = () => {
        listbox.hidden = true;
        input.setAttribute("aria-expanded", "false");
        input.removeAttribute("aria-activedescendant");
        active = -1;
      };

      const setActive = (index) => {
        const shown = visible();
        for (const li of shown) li.classList.remove("is-active");
        active = index;
        const li = shown.at(index);
        if (li) {
          li.classList.add("is-active");
          input.setAttribute("aria-activedescendant", li.id);
          li.scrollIntoView({ block: "nearest" });
        } else {
          input.removeAttribute("aria-activedescendant");
        }
      };

      const filter = () => {
        const q = input.value.trim().toLowerCase();
        for (const li of items) li.hidden = q.length > 0 && !(li.textContent ?? "").toLowerCase().includes(q);
      };

      const open = () => {
        filter();
        if (visible().length === 0) return close();
        listbox.hidden = false;
        input.setAttribute("aria-expanded", "true");
      };

      const select = (li) => {
        input.value = li.dataset.value ?? "";
        close();
        input.form?.requestSubmit();
      };

      input.addEventListener("input", open);
      input.addEventListener("focus", open);

      input.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          if (listbox.hidden) return open();
          const shown = visible();
          if (shown.length === 0) return;
          const step = event.key === "ArrowDown" ? 1 : -1;
          setActive((active + step + shown.length) % shown.length);
        } else if (event.key === "Enter") {
          const li = !listbox.hidden && active >= 0 ? visible().at(active) : undefined;
          if (li) {
            event.preventDefault();
            select(li);
          }
        } else if (event.key === "Escape") {
          close();
        }
      });

      listbox.addEventListener("mousedown", (event) => event.preventDefault());
      listbox.addEventListener("click", (event) => {
        const li = event.target.closest("[role='option']");
        if (li instanceof HTMLLIElement) select(li);
      });

      document.addEventListener("click", (event) => {
        if (!field.contains(event.target)) close();
      });
    }
  </script>

  {
    browsing ? (
      <section class="card results-card" aria-labelledby="results-heading">
        <div class="sched-head">
          <h2 id="results-heading">{heading}</h2>
          <nav aria-label="Jump to letter" class="letters">
            {letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
          </nav>
        </div>
        <div class="card-body">
          {letters.map((l) => (
            <div class="letter-group">
              <h3 id={`letter-${l}`}>{l}</h3>
              <ul class="subjects">
                {subjects
                  .filter((s) => s.code[0] === l)
                  .map((s) => (
                    <li>
                      <a href={link({ subject: s.code })}>
                        <strong>{s.code}</strong> <span>{s.name}</span>
                      </a>
                      <small>{s.count}</small>
                    </li>
                  ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ) : (
      <section class="results-card" aria-labelledby="results-heading">
        <div class="results-head">
          <div>
            <h2 id="results-heading">{heading}</h2>
            <p class="hint">
              {focus
                ? "One course"
                : `${results.length} ${results.length === 1 ? "course" : "courses"}`}
              {subject?.school && ` · ${subject.school}`}
            </p>
          </div>
          <a class="btn" href={base}>All subjects</a>
        </div>

        {namedSubjects.length > 0 && (
          <ul class="subjects subject-hits" aria-label="Matching subjects">
            {namedSubjects.map((s) => (
              <li>
                <a href={link({ subject: s.code })}>
                  <strong>{s.code}</strong> <span>{s.name}</span>
                </a>
                <small>{s.count} courses →</small>
              </li>
            ))}
          </ul>
        )}

        {levels.length > 1 && (
          <nav aria-label="Level" class="chips">
            <a href={link({ q, subject: subject?.code })} aria-current={!level ? "true" : undefined}>
              All levels
            </a>
            {levels.map((l) => (
              <a href={link({ q, subject: subject?.code, level: l })} aria-current={l === level ? "true" : undefined}>
                {l}-level
              </a>
            ))}
          </nav>
        )}

        {results.length === 0 ? (
          <p class="empty card">No Semester 2 courses match. Try a subject from the list, or fewer letters.</p>
        ) : (
          <div class="course-cards">
            {results.map((c) => (
              <CourseCard
                course={c}
                info={courseInfo(c.code)}
                activities={activitiesOf.get(c.id) ?? []}
                inPlan={inPlan.has(c.id)}
                prefs={prefs.filter((p) => p.courseId === c.id)}
                planId={plan.id}
                back={here}
                open={openClasses(c.id)}
              />
            ))}
          </div>
        )}
      </section>
    )
  }

  <p class="hint">
    {inPlan.size} {inPlan.size === 1 ? "course" : "courses"} in your plan ·{" "}
    <a href={`/plan/${plan.id}`}>See your schedules →</a>
  </p>
</Layout>

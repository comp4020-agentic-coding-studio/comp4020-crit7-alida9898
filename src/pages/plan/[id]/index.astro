---
import Layout from "../../../components/Layout.astro";
import WeekGrid from "../../../components/WeekGrid.astro";
import { meetingsFor } from "../../../lib/catalogue";
import { courseCode, generate, toSelection } from "../../../lib/generate";
import { clampPage, emptyMessage } from "../../../lib/plan-view";
import { getPlan, listPrefs, PLAN_COOKIE, planCookieOptions, planCourseIds } from "../../../lib/plans";
import { applyPrefs } from "../../../lib/prefs";

const plan = getPlan(Astro.params.id ?? "");
if (!plan) return Astro.rewrite("/404");
// opening a plan's link makes it the one "Continue your plan" returns to
Astro.cookies.set(PLAN_COOKIE, plan.id, planCookieOptions);

const ids = planCourseIds(plan.id);
const colours = new Map(ids.map((id, i) => [id, i % 8]));
const prefs = listPrefs(plan.id);
const pool = applyPrefs(meetingsFor(ids), prefs);
const narrowed = new Set(prefs.map((p) => `${courseCode(p.courseId)} ${p.activity}`));
// an activity with every class excluded can't be attended: no schedule works
const result = pool.emptied.length > 0 ? generate([]) : generate(pool.meetings);
const total = result.schedules.length;
const n = clampPage(Astro.url.searchParams.get("n"), total);
const schedule = result.schedules[n - 1];
const pageLink = (k: number) => `?n=${k}`;
---

<Layout title="Your plan — ANU Schedule Builder" plan={{ id: plan.id, current: "schedules" }}>
  <div class="page-head">
    <h1>Your plan</h1>
    <p class="hint">This page's link is your plan — bookmark it to come back from anywhere.</p>
  </div>

  <section class="card schedule" aria-labelledby="schedule-heading">
    {
      schedule ? (
        <>
          <div class="sched-head">
            <div>
              <h2 id="schedule-heading">
                Schedule {n} <span class="of">of {total}{result.capped && "+"}</span>
              </h2>
              <p class="hint">
                Every combination shown is clash-free.
                {result.capped && ` Showing the first ${total}.`}
              </p>
            </div>
            <div class="toolbar">
              <nav aria-label="schedules" class="pager">
                {n > 1 ? (
                  <a class="btn" href={pageLink(n - 1)}>‹ Previous</a>
                ) : (
                  <span class="btn disabled">‹ Previous</span>
                )}
                {n < total ? (
                  <a class="btn" href={pageLink(n + 1)}>Next ›</a>
                ) : (
                  <span class="btn disabled">Next ›</span>
                )}
              </nav>
              <form method="post" action={`/api/plans/${plan.id}/saved`}>
                <input type="hidden" name="selection" value={JSON.stringify(toSelection(schedule))} />
                <input type="hidden" name="n" value={String(n)} />
                <button class="primary">Save schedule</button>
              </form>
            </div>
          </div>
          <div class="card-body">
            <WeekGrid schedule={schedule} colours={colours} />
          </div>
        </>
      ) : (
        <>
          <div class="sched-head">
            <h2 id="schedule-heading">Schedules</h2>
          </div>
          <div class="card-body">
            <p class="empty">
              {pool.emptied.length > 0
                ? `You've excluded every ${pool.emptied[0]} class — undo one from its page under “Your courses”.`
                : emptyMessage(ids.length, result, narrowed)}
            </p>
            {ids.length === 0 && (
              <p class="empty-action">
                <a class="btn primary" href={`/plan/${plan.id}/search`}>Find courses</a>
              </p>
            )}
          </div>
        </>
      )
    }
  </section>
</Layout>
